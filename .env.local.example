# PostgreSQL (Neon) — pooled connection string
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require
TEST_DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require
# Auth.js session signing secret — generate with: npx auth secret
AUTH_SECRET=
# Resend transactional email
RESEND_API_KEY=
# Comma-separated admin allowlist (auto-promotes matching email to admin on signup) — D-10
ADMIN_EMAILS=
SEED_ADMIN_PASSWORD=
# Public base URL used to build verification links (safe to expose)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Phase 4: Payments ───────────────────────────────────────────────────────
# Stripe (PAY-01) — secret/webhook server-only; publishable is browser-safe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
ENABLE_STRIPE=true

# PayPal (PAY-02 DEFERRED — D-05a: PayPal does not support NGN). Toggle ships OFF.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
ENABLE_PAYPAL=false

# Bank transfer (PAY-03, D-10) — server-only; never NEXT_PUBLIC_
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
ENABLE_BANK_TRANSFER=true

# Flat-rate shipping (CHKT-03, D-15) — kobo; default 200000 = ₦2,000
FLAT_SHIPPING_KOBO=200000

# Paystack (PAY-05, D-06/D-08) — secret is server-only; public key is client-safe
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
ENABLE_PAYSTACK=true

# Flutterwave (PAY-06, D-06/D-08) — amounts are in NAIRA (major units), not kobo
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
FLUTTERWAVE_WEBHOOK_HASH=
ENABLE_FLUTTERWAVE=true

# ── Interswitch WebPay (PAY-09) — redirect-native; toggle OFF by default (D-19). Amounts in KOBO.
ENABLE_INTERSWITCH=false
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_MAC_KEY=           # 128-char MAC key — trim whitespace on paste (Pitfall 2)
INTERSWITCH_PRODUCT_ID=        # sandbox demo: 1076
INTERSWITCH_PAY_ITEM_ID=       # sandbox demo: 101

# ── GTPay (PAY-10) — GTBank on shared Interswitch WebPay core, own toggle (D-12). Amounts in KOBO.
ENABLE_GTPAY=false
GTPAY_MERCHANT_ID=
GTPAY_HASH_KEY=

# ── Remita (PAY-11) — redirect-native; toggle OFF by default (D-19). Amounts in NAIRA (÷100 on init).
ENABLE_REMITA=false
REMITA_MERCHANT_ID=
REMITA_API_KEY=
REMITA_SERVICE_TYPE_ID=

# ─── Phase 5: Admin Panel ─────────────────────────────────────────────────────
# Vercel Blob — product image storage (Phase 5, ADMN-01, D-03). Server-only.
# Create a Blob store in Vercel Dashboard → Storage → Blob, copy the read-write token.
BLOB_READ_WRITE_TOKEN=
